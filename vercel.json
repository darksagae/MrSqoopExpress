{
  "buildCommand": "npm run build",
  "devCommand": "vite",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/orders/item.ts": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  }
}
