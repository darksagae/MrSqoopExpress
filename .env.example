# Neon Postgres (auto-added by Vercel Neon integration)
DATABASE_URL=

# Admin credentials (server-side only — change these in production)
ADMIN_USERNAME=developer
ADMIN_PASSWORD=developer

# Used to sign admin session tokens (generate a long random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret

# Public URLs for domain routing
VITE_PUBLIC_SITE_URL=https://mrsqoopexpress.com
VITE_ADMIN_SITE_URL=https://control.mrsqoopexpress.com

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# The private key is server-side only; the public key is exposed via GET /api/push/subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Resend (https://resend.com) — used to email admin password reset links
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Mr Sqoop Express <no-reply@mrsqoopexpress.com>"
# Falls back to Resend's shared onboarding@resend.dev sender if unset.
RESEND_FROM_EMAIL=
# Where admin password reset links are sent
ADMIN_CONTACT_EMAIL=info@mrsqoopexpress.com
